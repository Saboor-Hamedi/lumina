{
  "name": "lumina",
  "version": "2.1.1",
  "description": "Lumina - A premium, AI-powered thinking environment.",
  "author": "Saboor Hamedi",
  "homepage": "https://github.com/Saboor-Hamedi/lumina",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "tauri dev",
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "build:renderer": "vite build",
    "build": "tauri build",
    "build:win": "tauri build",
    "build:mac": "tauri build --target universal-apple-darwin",
    "build:linux": "tauri build",
    "make:icons": "tauri icon resources/icon.png",
    "analyze": "vite build --mode analyze",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "workbench": "node scripts/workbench.js",
    "test": "vitest run",
    "test:rust": "cargo test -p lumina_core",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:all": "npm run typecheck && npm run test:rust && npm run test:run",
    "publish": "node scripts/publish.mjs",
    "publish:win": "tauri build",
    "publish:mac": "tauri build --target universal-apple-darwin",
    "publish:linux": "tauri build",
    "publish:all": "node scripts/publish.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1"
  },
  "devDependencies": {
    "@ai-sdk/deepseek": "^2.0.35",
    "@atomic-editor/editor": "^0.4.3",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/inference": "^2.8.0",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "ai": "^6.0.197",
    "autoprefixer": "^10.4.22",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "dexie": "^4.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fuse.js": "^7.4.2",
    "jsdom": "^25.0.1",
    "katex": "^0.18.5",
    "lucide-react": "^0.555.0",
    "mermaid": "^11.15.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-force-graph-2d": "^1.29.0",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "react-virtuoso": "^4.18.1",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.17",
    "three": "^0.185.1",
    "three-spritetext": "^1.10.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.6",
    "vitest": "^4.0.17",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  }
}
