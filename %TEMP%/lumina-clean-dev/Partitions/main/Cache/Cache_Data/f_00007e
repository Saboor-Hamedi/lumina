th: 100% !important;\r\n  display: block;\r\n  overflow-x: auto;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.email-detail-body pre,\r\n.email-detail-body code {\r\n  max-width: 100% !important;\r\n  overflow-x: auto;\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n  font-family: var(--font-mono, monospace);\r\n  color: var(--text-main, #f1f5f9);\r\n}\r\n\r\n/* Attachments bar in email detail */\r\n.email-attachments-bar {\r\n  padding: 8px 16px;\r\n  background: var(--bg-card, var(--bg-panel));\r\n  border-bottom: 1px solid var(--border-dim, var(--border-subtle));\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n\r\n.email-attachment-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 3px 8px;\r\n  border-radius: 5px;\r\n  background: var(--bg-active, rgba(125, 125, 125, 0.08));\r\n  border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));\r\n  font-size: 10.5px;\r\n  color: var(--text-main, #e2e8f0);\r\n}\r\n\r\n/* Responsive Narrow Mode (Class-based and Container Query based) */\r\n.email-detail-pane.narrow .email-action-reply-text {\r\n  display: none;\r\n}\r\n\r\n.email-detail-pane.narrow .email-action-reply-btn {\r\n  padding: 0 6px;\r\n}\r\n\r\n.email-detail-pane.narrow .email-detail-sender-row {\r\n  padding: 8px 10px;\r\n  gap: 8px;\r\n}\r\n\r\n.email-detail-pane.narrow .email-sender-avatar {\r\n  width: 26px;\r\n  height: 26px;\r\n  font-size: 11px;\r\n}\r\n\r\n.email-detail-pane.narrow .email-detail-body {\r\n  padding: 10px 12px;\r\n}\r\n\r\n.email-detail-pane.narrow .email-recipient-line {\r\n  flex-wrap: wrap;\r\n}\r\n\r\n@container detailPane (max-width: 360px) {\r\n  .email-action-reply-text {\r\n    display: none !important;\r\n  }\r\n  .email-action-reply-btn {\r\n    padding: 0 6px !important;\r\n  }\r\n  .email-detail-sender-row {\r\n    padding: 8px 10px !important;\r\n    gap: 8px !important;\r\n  }\r\n  .email-sender-avatar {\r\n    width: 26px !important;\r\n    height