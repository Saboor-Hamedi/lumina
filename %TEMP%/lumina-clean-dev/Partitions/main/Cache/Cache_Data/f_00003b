ortant;\r\n  position: relative !important;\r\n  box-sizing: border-box !important;\r\n  color: transparent !important;\r\n}\n\n.chat-bubble hr,\r\n.lumina-chat hr,\r\n.inline-lumina-response-content hr {\r\n  border: none !important;\r\n  border-top: none !important;\r\n  padding: 0 !important;\r\n  background: transparent !important;\r\n  width: 100% !important;\r\n  max-width: 280px !important;\r\n  margin: 0px auto !important;\r\n  height: 20px !important;\r\n  min-height: 20px !important;\r\n  position: relative !important;\r\n  display: flex !important;\r\n  align-items: center !important;\r\n  justify-content: center !important;\r\n  box-sizing: border-box !important;\r\n  color: transparent !important;\r\n}\n\n/* Ensure any natively rendered HR elements or text inside the line are completely hidden and borderless */\n\n.cm-line.cm-atomic-hr hr,\r\n.cm-line:has(.cm-hr) hr,\r\n.cm-line.cm-atomic-hr .cm-hr,\r\n.cm-line:has(.cm-hr) .cm-hr,\r\n.cm-line.cm-atomic-hr,\r\n.cm-line.cm-atomic-hr *,\r\n.cm-line:has(.cm-hr),\r\n.cm-line:has(.cm-hr) *,\r\n.chat-bubble hr *,\r\n.lumina-chat hr *,\r\n.inline-lumina-response-content hr * {\r\n  border: none !important;\r\n  border-top: none !important;\r\n  box-shadow: none !important;\r\n  outline: none !important;\r\n  background: transparent !important;\r\n  color: transparent !important;\r\n  text-decoration: none !important;\r\n}\n\n.cm-line.cm-atomic-hr::before,\r\n.cm-line:has(.cm-hr)::before,\r\n.chat-bubble hr::before,\r\n.lumina-chat hr::before,\r\n.inline-lumina-response-content hr::before {\r\n  content: '' !important;\r\n  position: absolute !important;\r\n  left: 50% !important;\r\n  transform: translateX(-50%) !important;\r\n  top: 50% !important;\r\n  width: 250px !important;\r\n  height: 2px !important;\r\n  background: linear-gradient(to right, transparent 0%, var(--text-accent) 25%, transparent 40%, transparent 60%, var(--text-accent) 75%, transparent 100%) !important;\r\n  pointer-events: none !important