hover, rgba(96, 165, 250, 0.15)) !important;\r\n  opacity: 1 !important;\r\n}\n\n/* Completely remove external link icon (↗) from wikilinks */\n\n.cm-atomic-wiki-link::after,\r\n.cm-atomic-wikilink-wrap::after,\r\n.cm-atomic-wiki-link-resolved::after,\r\n.cm-atomic-wiki-link-active::after,\r\n.cm-atomic-wiki-link .cm-atomic-link-icon,\r\n.cm-atomic-wiki-link-resolved .cm-atomic-link-icon {\r\n  display: none !important;\r\n  content: none !important;\r\n  width: 0 !important;\r\n  height: 0 !important;\r\n}\n\n/* Active Editing State: reveals the raw [[brackets]] seamlessly */\n\n.cm-atomic-wiki-link-active {\r\n  text-decoration: none !important;\r\n  background: var(--bg-modifier-hover, rgba(96, 165, 250, 0.12)) !important;\r\n  border-radius: 2px !important;\r\n  padding: 0 2px;\r\n}\n\n.cm-atomic-wiki-link-active .cm-wikilink-syntax {\r\n  display: inline !important;\r\n  color: var(--text-faint, #777777) !important;\r\n}\n\n/* Selection Highlight inside wikilinks */\n\n.cm-atomic-wiki-link::-moz-selection, .cm-atomic-wiki-link-active::-moz-selection {\r\n  background: var(--bg-selection, rgba(64, 186, 250, 0.35)) !important;\r\n  color: inherit !important;\r\n}\n\n.cm-atomic-wiki-link::selection,\r\n.cm-atomic-wiki-link-active::selection {\r\n  background: var(--bg-selection, rgba(64, 186, 250, 0.35)) !important;\r\n  color: inherit !important;\r\n}\n\n/* \r\n * ============ CONTEXT MENU SYSTEM ============\r\n * Controls the styling for all Context Menus across Lumina.\r\n * \r\n * LOCATIONS:\r\n * 1. Editor Context Menu: src/renderer/src/features/Editor/menu/index.jsx\r\n * 2. File Explorer / Nodes Menu: src/renderer/src/features/Navigation/hooks/useContextMenu.jsx\r\n * 3. Base Component: src/renderer/src/features/modals/ContextMenu.jsx\r\n * \r\n * This file (contextMenu.css) is globally imported in index.css.\r\n */\n\n.context-menu {\r\n  position: fixed;\r\n  min-width: 200px;\r\n  background: var(--bg-panel);\r\n  border: 1px solid var(--border-dim);\r\n  border-radius: 8px;\r\n  padding: 4px;\r\n  z-index: 10000;\r\n  animation: menuAppear 0.08s cubic-bezier(0, 0, 0.2, 1) forwards;\r\n  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.04);\r\n  will-change: transform, opacity;\r\n  transform-origin: top left;\r\n}\n\n@keyframes menuAppear {\r\n  from { opacity: 0; transform: scale(0.97) translateY(-2px); }\r\n  to { opacity: 1; transform: scale(1) translateY(0); }\r\n}\n\n.submenu {\r\n  position: absolute !important;\r\n  top: -4px;\r\n  left: 100% !important;\r\n  margin: 0 !important;\r\n  transform: translateX(5px);\r\n}\n\n/* Invisible bridge to prevent hover loss across the gap */\n\n.submenu::before {\r\n  content: \"\";\r\n  position: absolute;\r\n  top: 0;\r\n  bottom: 0;\r\n  left: -15px;\r\n  width: 15px;\r\n}\n\n.submenu.flip-left {\r\n  left: auto !important;\r\n  right: 100% !important;\r\n  transform: translateX(-5px);\r\n}\n\n.submenu.flip-left::before {\r\n  left: auto;\r\n  right: -15px;\r\n}\n\n.menu-item {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 6px 8px;\r\n  border-radius: 6px;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  cursor: default;\r\n  transition: background 0.05s ease, color 0.05s ease;\r\n  margin: 2px 0;\r\n}\n\n.menu-item:hover {\r\n  background: var(--bg-active);\r\n  color: var(--text-main);\r\n}\n\n.menu-shortcut {\r\n  background: transparent !important;\r\n  border: none !important;\r\n  box-shadow: none !important;\r\n  font-family: inherit;\r\n}\n\n.menu-label {\r\n  flex: 1;\r\n  font-weight: 500;\r\n}\n\n.menu-icon-right {\r\n  opacity: 0.7;\r\n  color: var(--text-accent);\r\n  display: flex;\r\n  align-items: center;\r\n}\n\n.menu-shortcut {\r\n  font-size: 10px;\r\n  opacity: 0.5;\r\n  font-weight: 600;\r\n}\n\n.menu-divider {\r\n  height: 1px;\r\n  background: var(--border-dim);\r\n  margin: 6px;\r\n}\n\n.menu-item.danger {\r\n  color: #ef4444;\r\n}\n\n.menu-item.danger:hover {\r\n  background: var(--bg-active);\r\n  color: #ef4444;\r\n}\n\n/* ==========================================================================\r\n   Lumina Multi-Level List & Bullet Styling (`lists.css`)\r\n   ========================================================================== */\n\n/* Base List Line: Inward Indentation from Headings and Paragraphs */\n\n.markdown-editor .cm-line:has(.cm-atomic-list-marker),\r\n.cm-line:has(.cm-atomic-list-marker) {\r\n  padding-left: 2.2em !important;\r\n  text-indent: -1.4em !important;\r\n}\n\n/* List Marker Alcove with crisp spacing gap before text */\n\n.markdown-editor .cm-atomic-list-marker,\r\n.cm-atomic-list-marker {\r\n  display: inline-flex !important;\r\n  align-items: center !important;\r\n  justify-content: center !important;\r\n  width: 0.8em !important;\r\n  min-width: 0.8em !important;\r\n  max-width: 0.8em !important;\r\n  margin-right: 0.6em !important;\r\n  padding: 0 !important;\r\n  vertical-align: baseline !important;\r\n  -webkit-user-select: none;\r\n     -moz-user-select: none;\r\n          user-select: none;\r\n  box-sizing: border-box !important;\r\n}\n\n/* Level 0 Parent Bullet: Refined, Solid Bullet (•) */\n\n.markdown-editor .cm-atomic-bullet,\r\n.cm-atomic-bullet {\r\n  display: inline-flex !important;\r\n  align-items: center !important;\r\n  justify-content: center !important;\r\n  width: 100% !important;\r\n  color: var(--text-muted, #888888) !important;\r\n  font-size: 0.85em !important;\r\n  line-height: 1 !important;\r\n  font-weight: 700 !important;\r\n  opacity: 0.85;\r\n}\n\n/* Level 1 Child Nested Bullet (Indented with 2 spaces or Tab): Open Circle (◦) */\n\n.markdown-editor .cm-line[style*=\"padding-left: 2.6\"] .cm-atomic-bullet,\r\n.markdown-editor .cm-line[style*=\"padding-left: 2.8\"] .cm-atomic-bullet,\r\n.cm-line[style*=\"padding-left: 2.6\"] .cm-atomic-bullet,\r\n.cm-line[style*=\"padding-left: 2.8\"] .cm-atomic-bullet {\r\n  font-size: 0.8em !important;\r\n  opacity: 0.75;